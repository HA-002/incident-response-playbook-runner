    {
      "parameters": {
        "jsCode": "const HOUR_MS = 60 * 60 * 1000;\nconst now = Date.now();\nconst MAX_PER_RUN = 10;\n\nfunction parseDate(value) {\n  if (value === null || value === undefined) return null;\n  if (typeof value === 'number') {\n    // Google Sheets serial date (days since 1899-12-30)\n    if (value > 20000 && value < 100000) {\n      const ms = Math.round((value - 25569) * 86400 * 1000);\n      return isNaN(ms) ? null : ms;\n    }\n    return null;\n  }\n  const str = String(value).trim();\n  if (!str) return null;\n  const ms = Date.parse(str);\n  return isNaN(ms) ? null : ms;\n}\n\nconst results = [];\nfor (const item of $input.all()) {\n  const row = item.json || {};\n  if (Object.keys(row).length === 0) continue;\n\n  const incidentId = String(row.incident_id ?? '').trim();\n  if (!incidentId) continue;\n\n  const statusRaw = String(row.status ?? '').trim();\n  const status = statusRaw || 'Open';\n  if (status.toLowerCase() === 'closed') continue;\n\n  const timeMs = parseDate(row.time);\n  if (timeMs === null) continue;\n  if (now - timeMs <= HOUR_MS) continue;\n\n  const lastReminderMs = parseDate(row.last_reminder);\n  if (lastReminderMs !== null && now - lastReminderMs <= HOUR_MS) continue;\n\n  results.push({\n    json: {\n      incident_id: incidentId,\n      incident_type: String(row.incident_type ?? '').trim() || 'Unknown',\n      status: status,\n      time: row.time,\n      hours_open: Math.round(((now - timeMs) / HOUR_MS) * 10) / 10,\n    },\n  });\n\n  if (results.length >= MAX_PER_RUN) break;\n}\n\nreturn results;"
      },
